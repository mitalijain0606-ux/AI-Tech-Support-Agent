# Copy to backend/.env for local development. Placeholders only: never commit real values.

# development | production. Production refuses to start on an unsafe configuration
# (auth off, wildcard CORS, a database that is behind its migrations).
ENVIRONMENT=development

# --- Authentication -----------------------------------------------------------------
# ON: every session endpoint needs an API key. Create one (printed once) with
#   python scripts/manage_keys.py create --tenant acme --subject you --role user
# and paste it into the extension popup under "Backend access".
# For purely local experiments you may set this to false (every caller is then one
# anonymous "public" tenant with full access). NEVER do that on a reachable host:
# ENVIRONMENT=production refuses to start with it off.
AUTH_REQUIRED=true

# --- Model --------------------------------------------------------------------------
# Empty = the labelled offline rule-based engine diagnoses (no network, known scenarios only).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
# combined = one grounded diagnose call per cycle (fewest calls; free-tier friendly).
# staged   = separate Classify, Diagnose and Plan calls, each scored by eval.py.
LLM_PIPELINE=combined

# --- Agent ----------------------------------------------------------------------------
# Below this diagnosis confidence a proposed fix is not offered; the session escalates to a human.
MIN_ACTION_CONFIDENCE=0.5
# Approximate token budget for the evidence shown to the model per cycle (budget.py).
EVIDENCE_TOKEN_BUDGET=8000

# --- Database -----------------------------------------------------------------------
# SQLite needs nothing. For Postgres (with pgvector) run `alembic upgrade head` first.
DATABASE_URL=sqlite:///./operon.db
# DATABASE_URL=postgresql://user:password@host:5432/operon

# --- Network ------------------------------------------------------------------------
# Browser origins allowed to call the API from page JavaScript. Empty = none (the
# extension does not need CORS: its manifest lists the backend origin). Never "*" in production.
CORS_ALLOW_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10
# Behind a reverse proxy only: believe the client address the proxy appended to X-Forwarded-For.
TRUST_FORWARDED_FOR=false
TRUSTED_PROXY_HOPS=1
# Shared rate limits and live events across several instances. Empty = per-instance.
REDIS_URL=

# --- Logging ------------------------------------------------------------------------
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Embeddings ---------------------------------------------------------------------
EMBEDDING_RETRY_COOLDOWN_SECONDS=60
# Where fastembed keeps the downloaded model (default: the system temp dir).
# FASTEMBED_CACHE_PATH=
