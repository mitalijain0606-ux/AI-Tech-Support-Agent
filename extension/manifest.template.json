{
  "manifest_version": 3,
  "name": "Operon (Dev)",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["__TARGET_MATCH__"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Operon"
  },
  "permissions": ["debugger", "storage", "cookies", "activeTab", "scripting"],
  "host_permissions": ["__TARGET_MATCH__"]
}
